# Database Connection
# For local host development (outside Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5436/policy_explainer
# For Docker internal networking (container to container):
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/policy_explainer

# AI Microservice Boundary
# For local host development (outside Docker):
# AI_SERVICE_URL=http://localhost:8001
# For Docker internal networking:
AI_SERVICE_URL=http://ai-service:8001

# LLM Provider Configuration
LLM_PROVIDER=groq

# Groq Configuration (Current Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini Configuration (Second Provider - for later use)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend Configuration
# URL of the backend API as accessible from the user's web browser:
VITE_API_BASE_URL=http://localhost:8000
